{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run tests (mydev/python/test_mydev.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/mydev/python/test_mydev.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/mydev",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "Build (py-debug)"
        },
        {
            "name": "Python: Current file (build py-debug before)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "Build (py-debug)"
        },
        {
            "name": "C++: mydev_backend.so (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${workspaceFolder}/mydev/python/test_mydev.py"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/mydev",
            "environment": [
                { "name": "PYTHONPATH", "value": "${workspaceFolder}" },
                { "name": "VIRTUAL_ENV", "value": "${workspaceFolder}/.venv" },
                { "name": "PATH", "value": "${workspaceFolder}/.venv/bin:${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Build (py-debug)"
        },
        {
            "name": "C++: dev.py (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${workspaceFolder}/mydev/python/dev.py"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/mydev",
            "environment": [
                { "name": "PYTHONPATH", "value": "${workspaceFolder}" },
                { "name": "VIRTUAL_ENV", "value": "${workspaceFolder}/.venv" },
                { "name": "PATH", "value": "${workspaceFolder}/.venv/bin:${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Build (py-debug)"
        },
        {
            "name": "C++: Attach to Python (gdb)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/.venv/bin/python",
            "processId": "${command:pickProcess}",
            "cwd": "${workspaceFolder}/mydev",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}